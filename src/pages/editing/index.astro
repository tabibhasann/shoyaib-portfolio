---
import Layout from '../../layouts/Layout.astro'
import PageHeader from '../../components/PageHeader.astro'
import ServiceCard from '../../components/ServiceCard.astro'
import {client, getSettings} from '../../lib/sanity.js'

const page = (await client.fetch(`*[_id == "editingPage"][0]`)) || {}
const settings = (await getSettings()) || {}
const seo = page.seo || {}
---
<Layout
  title={seo.title || `Editing — ${settings.name || 'Shoyaib'}`}
  description={seo.description}
  shareDescription={seo.shareDescription}
  path="/editing/"
  script="article"
  nav={[
    {href: '/#about', label: 'About'},
    {href: '/#services', label: 'Services'},
    {href: '/#contact', label: "Let's Talk", cta: true},
  ]}
  footerLink={{href: '/', label: 'Home ↑'}}
>
  <PageHeader header={page.header} />
  <section class="services" style="padding-top: 0;">
    <div class="container">
      <div class="service-cards">
        <ServiceCard href="/editing/video-editing.html" number="/01" card={page.videoCard} />
        <ServiceCard href="/editing/static-design.html" number="/02" card={page.staticCard} />
      </div>
    </div>
  </section>
</Layout>
