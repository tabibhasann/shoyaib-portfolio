---
/** Shown by GitHub Pages for any address that doesn't exist. */
import Layout from '../layouts/Layout.astro'
---
<Layout
  title="Page not found — Abu Musa"
  description="This page doesn't exist."
  path="/404.html"
  script="article"
  nav={[
    {href: '/', label: 'Home'},
    {href: '/editing/', label: 'Editing'},
    {href: '/#contact', label: "Let's Talk", cta: true},
  ]}
  footerLink={{href: '/', label: 'Home ↑'}}
>
  <section class="page-header">
    <div class="page-header-eyebrow">
      <span class="line"></span>
      <span class="eyebrow">404</span>
    </div>
    <h1>This page <span class="italic">wandered off</span>.</h1>
    <p class="page-header-sub">The link may be old or mistyped. Everything else is still here.</p>
    <a href="/" class="page-header-back">← Back to the home page</a>
  </section>
</Layout>
