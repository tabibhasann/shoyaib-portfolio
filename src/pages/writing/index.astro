---
import Layout from '../../layouts/Layout.astro'
import PageHeader from '../../components/PageHeader.astro'
import ArticleRows from '../../components/ArticleRows.astro'
import {client, getSettings, ARTICLE_ROW, withRemainder} from '../../lib/sanity.js'

const page = (await client.fetch(`*[_id == "writingPage"][0]{..., "articles": articles[]->${ARTICLE_ROW}}`)) || {}
const all = await client.fetch(`*[_type == "article" && defined(slug.current)] | order(date desc)${ARTICLE_ROW}`)
const spaceGuide = {title: 'A Trip Through Space: From Earth to the Multiverse', slug: 'trip-through-space', category: 'Science'}
const bigBangGuide = {title: 'From the Big Bang to the First Life on Earth', slug: 'big-bang-to-first-life', category: 'Science'}
const lifeGuide = {title: 'From the First Life to You and Me', slug: 'first-life-to-us', category: 'Science'}
const humanGuide = {title: 'How We Became Human', slug: 'how-we-became-human', category: 'Science'}
const articles = [humanGuide, lifeGuide, bigBangGuide, spaceGuide, ...withRemainder(page.articles, all).filter((a: any) => a.slug && a.slug !== spaceGuide.slug && a.slug !== bigBangGuide.slug && a.slug !== lifeGuide.slug && a.slug !== humanGuide.slug)]
const settings = (await getSettings()) || {}
const seo = page.seo || {}
---
<Layout
  title={seo.title || `Writing — ${settings.name || 'Shoyaib'}`}
  description={seo.description}
  shareDescription={seo.shareDescription}
  path="/writing/"
  script="article"
  nav={[
    {href: '/#about', label: 'About'},
    {href: '/editing/', label: 'Editing'},
    {href: '/#contact', label: "Let's Talk", cta: true},
  ]}
  footerLink={{href: '/', label: 'Home ↑'}}
>
  <PageHeader header={page.header} />
  <section class="writing-preview" style="padding-top: 0;">
    <div class="container">
      <ArticleRows articles={articles} base="/writing/" />
    </div>
  </section>
</Layout>
